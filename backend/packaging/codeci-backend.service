[Unit]
Description=codeci-backend (musicdl sidecar for codeci)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/codeci-backend --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
# Token is optional; set to a random secret for LAN/Termux profiles:
# Environment=CODECI_BACKEND_TOKEN=change-me

[Install]
WantedBy=default.target
